# Copie este arquivo para ".env" e preencha com suas credenciais.
# O ".env" é usado tanto para rodar o backend localmente (via python-dotenv)
# quanto pelo docker-compose (env_file do serviço tech-challenge-backend).

# GEMINI_API_KEY=

# Token de acesso do Hugging Face para downloads privados/autenticados e limites maiores.
# Gere-o em https://huggingface.co/settings/tokens e mantenha o valor somente no .env.
# HF_TOKEN=

# Modelo local do assistente: reduzir precisão e tamanho da resposta evita OOM e timeout.
ITEM1_PRELOAD=true
ITEM1_TORCH_DTYPE=float16
ITEM1_MAX_NEW_TOKENS=96

# Memória reservada ao container do backend; o Docker Desktop também deve ter ao menos esse valor disponível.
BACKEND_MEMORY_LIMIT=6g

# Tempo máximo da chamada do frontend. O preload evita que a primeira consulta consuma este prazo.
ASSISTANT_API_TIMEOUT_SECONDS=240

# Opcional: quantos resultados por requisição recebem interpretação da LLM
# (limite para evitar excesso de chamadas). Padrão: 5.
MAX_LLM_INTERPRETATIONS=5

GEMINI_MODEL_NAME=gemini-2.5-flash

USE_VERTEX_AI=true
VERTEX_PROJECT=deft-processor-357621
VERTEX_LOCATION=us-central1

# Para Vertex AI local com Docker, execute no host:
#   gcloud auth application-default login
# O compose monta automaticamente o arquivo ADC criado em
# ~/.config/gcloud/application_default_credentials.json como somente leitura.
HF_TOKEN=<HUGGING FACE TOKEN>
